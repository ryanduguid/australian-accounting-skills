# Client data must never enter this repo.
# Anything exported from a ledger or containing a real entity stays out.
input/
output/
clients/
exports/

# Data-file extensions (ledger exports, workbooks, statements, bank files)
*.xlsx
*.xlsm
*.xlsb
*.xls
*.xlt
*.xltx
*.xltm
*.csv
*.txt
!requirements-test.txt
*.pdf
*.aba
*.ofx
*.qif
*.zip
*.myox
*.myo
*.bak

# Generated-workpaper formats (the skills route packs to output/, ignored
# above; this catches strays written anywhere else)
*.docx
*.doc
*.json
*.md
# *.json must not swallow skill config — keep .claude/skills JSON trackable,
# nothing wider (settings.local.json and MCP/token JSON stay out)
!/.claude/skills/**/*.json
!.claude-plugin/marketplace.json
!.claude-plugin/plugin.json
!/.codex-plugin/
!/.codex-plugin/**/*.json
!/.agents/
!/.agents/plugins/
!/.agents/plugins/**/*.json
.claude/settings.local.json
# *.md must not swallow the repo's own docs — a checklist or register written
# as Markdown is the stray being caught here. Any future tracked Markdown
# (CONTRIBUTING.md, docs/*.md) needs its own negation added below.
!/README.md
!/DISCLAIMER.md
!/NOTICE
!/SECURITY.md
!/CONTRIBUTING.md
!/docs/
!/docs/*.md
!/RELEASE_NOTES.md
!/RELEASING.md
!/CLAUDE.md
!/AGENTS.md
!/.claude/skills/**/*.md
!/.claude/rules/
!/.claude/rules/**/*.md

# Fixed, fabricated regression cards. Keep this exception narrow: arbitrary
# Markdown elsewhere remains blocked as a possible generated workpaper.
!/validation/
!/validation/README.md
!/validation/cases/
!/validation/cases/*.md

# Allow sanitised sample fixtures when needed — sample-* convention only,
# matching the sibling repos. Uncomment here, ABOVE the client-name rules:
# gitignore is last-match-wins, so the *client* guard below must stay the
# last word.
# !samples/
# !samples/sample-*.csv

# Client-named data files (scoped to data extensions so docs/skills named
# "client-*" are never silently swallowed). Keep these below any sample
# re-includes — last match wins.
*client*.csv
*client*.xlsx
*client*.pdf

# Python
__pycache__/
*.py[cod]

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
